# ---------- required ----------
# DNS A record → this server's public IP
DOMAIN=qinfang.example.com
# the server's public IPv4 (coturn advertises it)
PUBLIC_IP=203.0.113.10
# Let's Encrypt notices
ACME_EMAIL=admin@example.com
# openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# ---------- rooms ----------
MAX_PEERS=6
ROOM_TTL_HOURS=24

# ---------- live captions ----------
# Recogniser per spoken language: tencent | yandex | openai | none
#   Chinese  → tencent   (Tencent Cloud has no Russian engine)
#   Russian  → yandex    (Yandex SpeechKit has no Chinese model)
#   English  → tencent or yandex
ASR_ZH=tencent
ASR_RU=yandex
ASR_EN=tencent
# Translation for all pairs: tencent | yandex | openai | none
TRANSLATE=tencent

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-hongkong
# International site endpoints (use if the account is on tencentcloud.com):
# TENCENT_ASR_HOST=asr.intl.tencentcloudapi.com
# TENCENT_TMT_HOST=tmt.intl.tencentcloudapi.com

YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Optional. OpenAI does not serve mainland China, Hong Kong or Russia, so it only works if this
# server is elsewhere or OPENAI_BASE_URL points at a compatible gateway you are allowed to use
# (e.g. Azure OpenAI, or Alibaba DashScope compatible-mode for TRANSLATE=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
